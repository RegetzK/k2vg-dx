<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>K2VG DX Monitor</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:#000000;
  color:#f4f4f4;
  font-family:'Century Gothic','AppleGothic','Futura',sans-serif;
  overflow:hidden;
  height:280px;
  width:100%;
  padding:6px 8px;
}
.panel-label{
  color:#00ff66;
  font-size:9px;
  font-weight:bold;
  letter-spacing:1px;
  text-transform:uppercase;
  text-align:center;
  margin-bottom:4px;
  text-shadow:0 0 6px rgba(0,255,102,0.5);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
table{
  border-collapse:collapse;
  border:1px solid #00ff66;
  width:100%;
  font-family:monospace;
  font-size:11px;
}
th,td{
  border:1px solid #1f2937;
  padding:2px 5px;
  text-align:left;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  max-width:120px;
}
th{
  border-bottom:2px solid #00ff66;
  color:#00ff66;
  font-size:9px;
  letter-spacing:1px;
  text-transform:uppercase;
  background:#0b0c10;
}
tr.lore td{
  color:#00ff66;
  font-weight:bold;
}
tr.lore td:last-child{
  color:#00e5ff;
}
tr.telemetry td{
  color:#f4f4f4;
}
tr.telemetry td.snr{
  color:#ffcc00;
}
.status-bar{
  display:flex;
  justify-content:space-between;
  margin-top:4px;
  font-family:monospace;
  font-size:9px;
  color:#666666;
}
.status-bar .live{color:#00ff66}
.status-bar .degraded{color:#e74c3c}
</style>
</head>
<body>
<div class="panel-label">DEEP COVER IC-7300 &amp; BETA 5 TRANSCEIVER ARRAY INTERSTELLAR MONITORING STATION PANEL</div>
<table>
  <thead>
    <tr>
      <th>CALL</th>
      <th>GRID</th>
      <th>BAND</th>
      <th>SNR</th>
      <th>DXCC</th>
      <th>STATUS</th>
    </tr>
  </thead>
  <tbody>
    <tr class="lore"><td>NCC-1701</td><td>GSO-FM18</td><td>ALL</td><td>LOCK</td><td>USS ENTERPRISE</td><td>UPLINK ACTIVE</td></tr>
    <tr class="lore"><td>N/A</td><td>40 ERIDANI A</td><td>ALL</td><td>STATIC</td><td>VULCAN</td><td>MONITORING 🖖</td></tr>
    <tr class="lore"><td>IC/MIL/GOV COMMS</td><td>ALL</td><td>ALL</td><td>SCAN</td><td>EARTH</td><td>MONITORING</td></tr>
    <tr class="lore"><td>CIV WEB/DARK WEB/COMMS</td><td>ALL</td><td>ALL</td><td>SCAN</td><td>EARTH</td><td>MONITORING</td></tr>
    <tbody>
  </tbody>
</table>
<div class="status-bar">
  <span id="status">INITIALIZING...</span>
  <span id="timestamp">--:--:--Z</span>
</div>
<script>
const MAX_ROWS=7;
const SNR_MIN=-24;
const SNR_MAX=-15;
function bandFromFreq(mhz){
  if(mhz>=1.8&&mhz<2)return'160M';
  if(mhz>=3.5&&mhz<4)return'80M';
  if(mhz>=5.3&&mhz<5.4)return'60M';
  if(mhz>=7&&mhz<7.3)return'40M';
  if(mhz>=10.1&&mhz<10.15)return'30M';
  if(mhz>=14&&mhz<14.35)return'20M';
  if(mhz>=18&&mhz<18.16)return'17M';
  if(mhz>=21&&mhz<21.45)return'15M';
  if(mhz>=24.89&&mhz<24.99)return'12M';
  if(mhz>=28&&mhz<29.7)return'10M';
  if(mhz>=50&&mhz<54)return'6M';
  return Math.round(mhz)+'M';
}
function iaruRegion(grid){
  const c=grid.substring(0,2);
  const col=parseInt(c[0],36);
  const row=parseInt(c[1],36);
  if(col<=18)return'R1';
  if(col<=22)return'R2';
  return'R3';
}
async function load(){
  try{
    const r=await fetch('data/telemetry.json?t='+Date.now());
    if(!r.ok)throw r.status;
    const d=await r.json();
    const tb=document.querySelector('tbody');
    const tracks=d.telemetry.dx_tracks||[];
    const filtered=tracks.filter(t=>t.db>=SNR_MIN&&t.db<=SNR_MAX).slice(0,MAX_ROWS);
    let html='';
    for(const t of filtered){
      const reg=iaruRegion(t.grid);
      html+=`<tr class="telemetry"><td>${t.call}</td><td>${t.grid}</td><td>${t.band||bandFromFreq(t.freq)}</td><td class="snr">${t.db}dB</td><td>${t.dxcc||t.call.substring(0,2)}</td><td>${reg}</td></tr>`;
    }
    if(!filtered.length)html='<tr class="telemetry"><td colspan="6" style="color:#666;text-align:center">SCANNING... NO SIGNALS IN RANGE</td></tr>';
    tb.insertAdjacentHTML('beforeend',html);
    document.getElementById('status').textContent=d.telemetry.status||'ONLINE';
    document.getElementById('status').className=d.telemetry.status==='ONLINE'?'live':'degraded';
    document.getElementById('timestamp').textContent=d.timestamp||'--:--:--Z';
  }catch(e){
    document.getElementById('status').textContent='DEGRADED';
    document.getElementById('status').className='degraded';
  }
}
load();
setInterval(load,300000);
</script>
</body>
</html>   
